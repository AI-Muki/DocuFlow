# --- DocuFlow AI Phase 2A Development Configuration ---

# Database (PostgreSQL)
DATABASE_URL="postgresql://docuflow:docuflow_secret@localhost:5432/docuflow_db?schema=public"

# Authentication (Development secret)
AUTH_SECRET="dev-jwt-secret-key-docuflow-min-32-chars-safe"
AUTH_TOKEN_EXPIRY="7d"

# Storage Provider (Phase 2A development uses local storage)
STORAGE_PROVIDER="local"

# AI Provider Configuration (Phase 2A development uses mock configuration)
AI_PROVIDER="mock"
AI_EMBEDDING_MODEL="mock"
AI_REASONING_MODEL="mock"


