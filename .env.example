# --- DocuFlow AI Phase 2B Development Configuration ---

# Database (PostgreSQL)
DATABASE_URL="postgresql://docuflow:docuflow_secret@localhost:5432/docuflow_db?schema=public"

# Authentication (Development secret)
AUTH_SECRET="dev-jwt-secret-key-docuflow-min-32-chars-safe"
AUTH_TOKEN_EXPIRY="7d"

# Storage Provider (Phase 2B local storage)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="storage_uploads"
MAX_FILE_SIZE_BYTES="26214400"
SIGNED_URL_EXPIRY_SECONDS="3600"
STORAGE_SIGNED_URL_SECRET="storage-signing-secret-key-docuflow-min-32-chars"

# AI Provider Configuration (mock for Phase 2A/2B)
AI_PROVIDER="mock"
AI_EMBEDDING_MODEL="mock"
AI_REASONING_MODEL="mock"


